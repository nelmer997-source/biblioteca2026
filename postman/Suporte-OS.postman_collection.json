{
  "info": {
    "name": "Biblioteca 2026 - Aula 17 (Auditoria e Protecao)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "operadorToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "loginAlvo", "value": "operador.teste" },
    { "key": "senhaCorreta", "value": "senha-operador-auditoria-2026" },
    { "key": "senhaIncorreta", "value": "senha-incorreta-2026" }
  ],
  "item": [
    {
      "name": "11 — Proteção e auditoria da autenticação",
      "item": [
        {
          "name": "01. Login Admin (obter JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"senha-admin-auditoria-2026\"\n}"
            },
            "url": "{{baseUrl}}/api/autenticacao/login"
          }
        },
        {
          "name": "02. Login com senha incorreta (repetir 5x para ativar bloqueio)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 generico', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().message).to.eql('Login ou senha inválidos');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{loginAlvo}}\",\n  \"senha\": \"{{senhaIncorreta}}\"\n}"
            },
            "url": "{{baseUrl}}/api/autenticacao/login"
          }
        },
        {
          "name": "03. 6a tentativa com senha CORRETA apos bloqueio (401 generico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Recusado com 401 mesmo com senha correta', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().message).to.eql('Login ou senha inválidos');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{loginAlvo}}\",\n  \"senha\": \"{{senhaCorreta}}\"\n}"
            },
            "url": "{{baseUrl}}/api/autenticacao/login"
          }
        },
        {
          "name": "04. Comparacao conta INEXISTENTE (401 generico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Conta inexistente retorna mesmo 401 generico', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().message).to.eql('Login ou senha inválidos');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"usuario.nao.existe.2026\",\n  \"senha\": \"qualquer-senha-2026\"\n}"
            },
            "url": "{{baseUrl}}/api/autenticacao/login"
          }
        },
        {
          "name": "05. Consultar trilha de auditoria (ADMINISTRADOR -> 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 e sem identificadorHash', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.text()).to.not.include('identificadorHash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/auditoria-seguranca?page=0&size=20"
          }
        }
      ]
    }
  ]
}
